diff --git a/code/include/motion_lease.h b/code/include/motion_lease.h
new file mode 100644
index 0000000..ffb89fc
--- /dev/null
+++ b/code/include/motion_lease.h
@@ -0,0 +1,29 @@
+#pragma once
+#include <stdint.h>
+
+// Accessed by the HTTP/loop task only. Expiry is latched until explicit Start.
+class MotionLease {
+public:
+    explicit MotionLease(uint32_t timeout = 1500) : timeout_(timeout) {}
+    void start(uint32_t now) { last_ = now; active_ = true; }
+    bool feed(uint32_t now) {
+        if (!active_) return false;
+        // A late heartbeat must never revive an expired lease.
+        if (uint32_t(now - last_) >= timeout_) { active_ = false; return false; }
+        last_ = now;
+        return true;
+    }
+    bool expired(uint32_t now) {
+        if (active_ && uint32_t(now - last_) >= timeout_) {
+            active_ = false;
+            return true;
+        }
+        return false;
+    }
+    void stop() { active_ = false; }
+    bool active() const { return active_; }
+private:
+    uint32_t timeout_;
+    uint32_t last_ = 0;
+    bool active_ = false;
+};
diff --git a/code/test/native/watchdog.cpp b/code/test/native/watchdog.cpp
new file mode 100644
index 0000000..3efacbe
--- /dev/null
+++ b/code/test/native/watchdog.cpp
@@ -0,0 +1,23 @@
+#include <cassert>
+#include "motion_lease.h"
+int main() {
+    MotionLease lease(1500);
+    assert(!lease.feed(0));
+    lease.start(100);
+    assert(!lease.expired(1599));
+    assert(lease.expired(1600));
+    assert(!lease.feed(1601)); // Cannot revive expired lease.
+    lease.start(2000);
+    assert(lease.feed(3000));
+    assert(!lease.expired(4499));
+    assert(lease.expired(4500));
+    lease.start(0xfffffff0u);
+    assert(lease.feed(0x100u)); // millis wrap-around.
+    assert(lease.expired(0x100u + 1500));
+    lease.start(0);
+    lease.stop();
+    assert(!lease.feed(1));
+    lease.start(0);
+    assert(!lease.feed(1500)); // Late heartbeat also latches expiry.
+    assert(!lease.active());
+}
